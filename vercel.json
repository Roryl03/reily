{
  "rewrites": [
    { "source": "/api/community/moderation", "destination": "/api/community-moderation" },
    { "source": "/api/reviews/submit", "destination": "/api/reviews-submit" },
    { "source": "/api/reviews/list", "destination": "/api/reviews-list" },
    { "source": "/api/reviews/summary", "destination": "/api/reviews-summary" },
    { "source": "/api/reviews/helpful", "destination": "/api/reviews-helpful" },
    { "source": "/api/reviews/report", "destination": "/api/reviews-report" },
    { "source": "/api/top-picks", "destination": "/api/top-picks-index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
