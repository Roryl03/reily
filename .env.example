# Option A — manual (Vite-style)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Option B — auto from `vercel env pull` after linking Supabase in Vercel:
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...  (or SUPABASE_PUBLISHABLE_KEY)

# Optional legacy admin key (only used when Supabase is NOT configured)
VITE_ADMIN_KEY=

# Supabase Auth: add these redirect URLs in the Supabase dashboard (Authentication → URL config):
# https://askreillyni.com/add-service
# https://www.askreillyni.com/add-service
