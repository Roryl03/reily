# Option A — manual (Vite-style)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Option B — auto from `vercel env pull` after linking Supabase in Vercel:
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...  (or SUPABASE_PUBLISHABLE_KEY)

# Admin / Insights API key (legacy ?key= unlock + insights dashboard auth)
ADMIN_KEY=

# Run supabase/analytics.sql in Supabase to enable event storage
# Add SUPABASE_SERVICE_ROLE_KEY on Vercel for insights aggregation API reads

# Map tiles — free CARTO key (recommended): https://carto.com/basemaps/apikey
# Use domain askreillyni.com when requesting. Without this, OpenStreetMap tiles are used.
CARTO_API_KEY=

# Supabase Auth: add these redirect URLs in the Supabase dashboard (Authentication → URL config):
# https://askreillyni.com/add-service
# https://www.askreillyni.com/add-service
